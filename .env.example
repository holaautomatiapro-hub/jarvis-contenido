# Copia este archivo como .env y rellena tus claves. Nunca lo subas a GitHub.
PORT=3333

# Ruta a tu vault de Obsidian (se crea en la instalación)
VAULT_PATH=C:\Users\TU_USUARIO\Documents\JARVIS-Vault

# Voz (ElevenLabs). Sin clave, JARVIS responde con la voz del navegador.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 (rápida, por defecto) o eleven_multilingual_v2 (más natural, algo más lenta)
ELEVENLABS_MODEL=eleven_flash_v2_5

# Meta (Instagram y Meta Ads). Guía paso a paso en docs/INSTAGRAM.md
# Con App ID y secreto aparece el botón "Conectar con Facebook" en la pestaña Instagram.
META_APP_ID=
META_APP_SECRET=
# Solo si tu app usa "Inicio de sesión con Facebook para empresas": el ID de la configuración
META_CONFIG_ID=
META_GRAPH_VERSION=v23.0
# Cuenta publicitaria para Meta Ads, formato act_123456789 (también se elige desde la pestaña Meta Ads)
META_AD_ACCOUNT_ID=
# Tope de presupuesto diario que JARVIS puede proponer (euros) y país de la Ad Library
ADS_PRESUPUESTO_MAX_DIA=50
ADS_PAIS=ES

# Competidores que se analizan al empezar (luego se gestionan desde la pestaña Competencia)
COMPETIDORES=

# Sincronización de Instagram
IG_SYNC_HORAS=6
# Reels que se transcriben como máximo en cada sincronización (consume créditos de ElevenLabs)
IG_TRANSCRIBIR_MAX=10
# Pon 0 para que JARVIS no haga tareas automáticas (clasificar temas, perfil de voz)
JARVIS_AUTO=1

# Hermes (JARVIS por Telegram). Guía en docs/HERMES.md. Sus claves (bot y modelo) van en el .env de Hermes, no aquí.
# Panel de Hermes (hermes dashboard), para el estado "online" si el bot no está corriendo en este PC
HERMES_DASHBOARD_URL=http://localhost:9119
# Solo si instalaste Hermes en otra carpeta (por defecto %LOCALAPPDATA%\hermes) o el comando no está en el PATH
HERMES_HOME=
HERMES_BIN=
