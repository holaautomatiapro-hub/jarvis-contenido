diff a/.env.example b/.env.example	(rejected hunks)
@@ -49,3 +49,13 @@ CRM_SUPABASE_ANON_KEY=
 WINDSOR_API_KEY=
 # Si en Windsor tienes varias cuentas de Instagram, la tuya (usuario sin @)
 WINDSOR_CUENTA=
+
+# Lead magnets (Laboratorio → Lead magnets): se publican en Vercel. Se rellenan solos desde esa pantalla
+# (el token se comprueba y se guarda aquí; nunca lo pegues en el chat). Token: vercel.com/account/tokens
+VERCEL_TOKEN=
+# Vacío = tu cuenta personal. Si es de un equipo: team_…
+VERCEL_TEAM_ID=
+# Nombre del proyecto en Vercel: los enlaces quedan en https://<proyecto>.vercel.app/<lead-magnet>
+VERCEL_PROYECTO=leadmagnets
+# Opcional: un dominio propio ya añadido a ese proyecto en Vercel (p. ej. recursos.tudominio.com)
+VERCEL_DOMINIO=
